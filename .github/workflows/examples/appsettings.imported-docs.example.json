// Example appsettings.json configuration for the imported-docs plugin
// with both push-based and pull-based documentation sources

{
  "siteConfig": {
    // ... other site config ...
    
    "importedDocs": {
      // Directory where external repos push documentation (push-based)
      // Files here are automatically discovered and imported
      "pushedDocsDir": "imported",
      
      // Array of remote repositories to pull from (pull-based)
      "pullSources": [
        {
          // Example 1: Public repository, pull from main branch
          "repository": "https://github.com/myorg/api-docs.git",
          "sourcePath": "docs",                    // Where docs live in the repo
          "destinationPath": "products/api",       // Where to place on main site
          "includeSourceMarker": true,             // Add import_source metadata
          "exclude": [
            "draft/**",                            // Exclude draft folder
            "INTERNAL-*.md"                        // Exclude internal docs
          ]
        },
        
        {
          // Example 2: Pull specific tag/branch with defaults
          "repository": "https://github.com/myorg/cli-repo.git",
          "reference": "v2.0",                     // Specific tag/branch/commit
          "sourcePath": "docs",
          "destinationPath": "products/cli",
          "frontMatterDefaults": {
            "nav_title": "CLI Tool",               // Default nav title
            "hide_toc": false
          }
        },
        
        {
          // Example 3: Private repository with authentication
          "repository": "https://github.com/myorg/private-docs.git",
          "sourcePath": "documentation",
          "destinationPath": "internal/private",
          "authTokenEnvVar": "GITHUB_TOKEN",       // Use env var for auth
          "exclude": [
            "*.draft.md",
            "confidential/**"
          ]
        }
      ]
    }
  },
  
  // Plugin configuration
  "plugins": [
    // ... other plugins ...
    {
      "name": "imported-docs"
      // No options needed; configure via siteConfig.importedDocs
    }
  ]
}
