{
  "name": "netdocs-cms-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Admin app and in-page editor for the Netdocs local CMS. `npm run build` writes the bundle to src/Netdocs.Cli/Cms/wwwroot, which is committed so building Netdocs needs no Node toolchain.",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/theme-one-dark": "6.1.3",
    "codemirror": "6.0.2",
    "preact": "11.2.0",
    "turndown": "7.2.5",
    "turndown-plugin-gfm": "1.0.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/turndown": "5.0.6",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
